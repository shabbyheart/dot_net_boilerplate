# Copy to deploy/.env (git-ignored) and choose a local-only password.
POSTGRES_PASSWORD=

# Optional: host ports, if the defaults are already in use on your machine.
# POSTGRES_PORT=5432
# API_PORT=8080

# Optional: the OpenID Connect issuer whose tokens the API accepts (ADR-0016), and the expected audience.
# Without AUTH_AUTHORITY the stack starts, but no token is accepted.
# AUTH_AUTHORITY=https://your-identity-provider.example/realms/your-realm
# AUTH_AUDIENCE=boilerplate-api
